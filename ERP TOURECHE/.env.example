# انسخ هذا الملف إلى .env (اختياري) — لا ترفع .env إلى git أبداً
# Copiez en .env (facultatif) — ne jamais committer .env

# المنفذ وعنوان الاستماع
ERP_PORT=3600
ERP_HOST=0.0.0.0

# مجلد البيانات (قاعدة البيانات، الصور، النسخ الاحتياطية) — افتراضياً ./data
# ERP_DATA_DIR=/Users/you/ERP-data

# مفتاح تشفير الأسرار (اختياري): إن لم يُحدد يُولَّد تلقائياً في data/.secret-key — احفظ نسخة منه!
# ERP_SECRET_KEY=

# مدة الجلسة بالأيام
ERP_SESSION_DAYS=14

# بعد إدخال كلمة المرور الحساسة، لا تُطلب مجدداً لمدة (بالدقائق). 0 = تُطلب في كل عملية
ERP_SENSITIVE_WINDOW_MIN=0

# عند التشغيل خلف «tailscale serve» أو Cloudflare Tunnel
ERP_TRUST_PROXY=1
# عناوين عامة إضافية مسموحة (افصل بفاصلة)، مثل https://erp.your-tailnet.ts.net
# ERP_ALLOWED_ORIGINS=

# مفتاح Claude يمكن وضعه هنا أو من الإعدادات داخل الـ ERP (مشفّر)
# ANTHROPIC_API_KEY=
