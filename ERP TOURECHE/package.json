{
  "name": "erp-toureche",
  "version": "1.0.0",
  "private": true,
  "description": "ERP TOURECHE — نظام إدارة متاجر الدفع عند الاستلام (Shopify · Meta Ads · Yalidine · ZR Express · NOEST · n8n · Claude)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm install && npm --prefix client install && npm --prefix client run build",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "test": "node --test \"tests/*.test.js\"",
    "reset-password": "node server/cli.js reset-password",
    "restore": "node server/cli.js restore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "multer": "2.0.2"
  }
}
